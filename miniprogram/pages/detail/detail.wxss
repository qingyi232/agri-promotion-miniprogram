.page-detail {
  padding-bottom: 130rpx;
  background: #f6f7f2;
}

.detail-cover {
  width: 100%;
  height: 480rpx;
}

.detail-body {
  padding: 30rpx;
  background: #fff;
  margin-top: -40rpx;
  border-radius: 30rpx 30rpx 0 0;
  position: relative;
}

.detail-tags {
  margin-bottom: 16rpx;
}

.detail-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 24rpx;
}

.detail-author-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.detail-author {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  background: #e8f5e9;
}

.author-info {
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.publish-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.detail-content {
  font-size: 30rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 30rpx;
}

.detail-images {
  margin-bottom: 30rpx;
}

.detail-img-item {
  width: 100%;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

/* 产地信息卡片 */
.origin-card {
  background: linear-gradient(135deg, #f0f7f0, #fafdf7);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-top: 10rpx;
  border: 1rpx solid #e0eddf;
}

.origin-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.origin-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.origin-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #3a7d44;
}

.origin-body {
  display: flex;
  flex-direction: column;
}

.origin-item {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.origin-item:first-child {
  margin-top: 0;
}

.origin-label {
  font-size: 26rpx;
  color: #888;
  width: 80rpx;
  flex-shrink: 0;
}

.origin-value {
  font-size: 26rpx;
  color: #444;
}

/* 互动数据 */
.interact-stats {
  display: flex;
  background: #fff;
  padding: 30rpx;
  margin-top: 16rpx;
  justify-content: space-around;
}

.interact-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.interact-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #3a7d44;
}

.interact-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 评论区 */
.comment-section {
  background: #fff;
  margin-top: 16rpx;
  padding: 30rpx;
}

.section-header {
  margin-bottom: 24rpx;
}

.section-header-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.comment-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #e8f5e9;
}

.comment-body {
  flex: 1;
}

.comment-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.comment-user {
  font-size: 26rpx;
  font-weight: 500;
  color: #444;
}

.comment-time {
  font-size: 22rpx;
  color: #bbb;
}

.comment-text {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
}

.empty-comment {
  text-align: center;
  padding: 40rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  background: #fff;
  padding: 16rpx 24rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.comment-input-wrap {
  flex: 1;
  background: #f5f6f0;
  border-radius: 36rpx;
  padding: 16rpx 28rpx;
  margin-right: 16rpx;
}

.comment-placeholder {
  font-size: 26rpx;
  color: #bbb;
}

.bottom-actions {
  display: flex;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 16rpx;
  min-width: 80rpx;
  margin-left: 12rpx;
}

.action-icon {
  width: 44rpx;
  height: 44rpx;
}

.action-text {
  font-size: 20rpx;
  color: #999;
  margin-top: 2rpx;
}

.action-btn.active .action-text {
  color: #3a7d44;
}

/* 评论弹窗 */
.comment-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 200;
  display: flex;
  align-items: flex-end;
}

.comment-modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 30rpx 30rpx 50rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

.comment-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: #333;
  padding: 16rpx;
  box-sizing: border-box;
  background: #f6f7f2;
  border-radius: 12rpx;
}

.comment-submit-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.comment-count {
  font-size: 24rpx;
  color: #bbb;
}

.comment-submit-btn {
  background: #3a7d44 !important;
  color: #fff !important;
  font-size: 26rpx !important;
  border-radius: 36rpx !important;
  padding: 12rpx 40rpx !important;
  border: none !important;
  min-height: auto !important;
  line-height: 1.5 !important;
}

.comment-submit-btn[disabled] {
  opacity: 0.5;
}

.comment-submit-btn::after {
  border: none;
}
