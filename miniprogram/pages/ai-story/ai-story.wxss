.page-ai {
  min-height: 100vh;
  background: #f6f7f2;
  padding-bottom: 60rpx;
}

/* 顶部 */
.ai-header {
  background: linear-gradient(135deg, #3a7d44, #2e7d32, #1b5e20);
  padding: 60rpx 30rpx 50rpx;
  text-align: center;
  color: #fff;
}

.ai-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
}

.ai-icon {
  width: 64rpx;
  height: 64rpx;
}

.ai-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.ai-desc {
  display: block;
  font-size: 26rpx;
  opacity: 0.85;
}

/* 表单 */
.ai-form {
  padding: 30rpx;
}

.form-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  padding: 16rpx 20rpx;
  background: #f6f7f2;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  background: #f6f7f2;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.category-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-tag {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #f6f7f2;
  border: 1rpx solid #e0e0e0;
  transition: all 0.2s;
}

.cat-tag.active {
  background: #e8f5e9;
  color: #3a7d44;
  border-color: #3a7d44;
  font-weight: 600;
}

/* 生成按钮 */
.ai-generate-btn {
  display: flex !important;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #3a7d44, #2e7d32) !important;
  color: #fff !important;
  font-size: 30rpx !important;
  font-weight: 600 !important;
  border-radius: 48rpx !important;
  padding: 24rpx 0 !important;
  margin-top: 30rpx;
  border: none !important;
}

.ai-generate-btn.disabled {
  opacity: 0.5;
}

.ai-generate-btn::after {
  border: none;
}

.btn-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

/* 结果区域 */
.ai-result {
  padding: 0 30rpx;
  margin-top: 10rpx;
}

.result-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.result-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}

.result-title-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #3a7d44;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  border-left: 6rpx solid #3a7d44;
  box-shadow: 0 2rpx 16rpx rgba(58,125,68,0.08);
}

.result-story-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.result-story-content {
  display: block;
  font-size: 28rpx;
  color: #555;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.result-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.result-tag {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  background: #e8f5e9;
  color: #3a7d44;
}

/* 操作按钮 */
.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.action-submit {
  flex: 1;
  background: #3a7d44 !important;
  color: #fff !important;
  font-size: 28rpx !important;
  border-radius: 40rpx !important;
  border: none !important;
}

.action-submit::after {
  border: none;
}

.action-regenerate {
  flex: 1;
  background: #fff !important;
  color: #3a7d44 !important;
  font-size: 28rpx !important;
  border-radius: 40rpx !important;
  border: 2rpx solid #3a7d44 !important;
}

.action-regenerate::after {
  border: none;
}
