.page-history {
  min-height: 100vh;
  background: #f6f7f2;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #fff;
}

.history-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}

.history-clear {
  font-size: 26rpx;
  color: #e57373;
}

.history-group {
  margin-top: 16rpx;
}

.history-date {
  padding: 16rpx 30rpx;
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.history-item {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.history-cover {
  width: 180rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.history-info {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.history-item-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #222;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.history-item-summary {
  font-size: 24rpx;
  color: #888;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-top: 6rpx;
}

.history-item-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.history-author {
  font-size: 22rpx;
  color: #3a7d44;
}

.history-time {
  font-size: 22rpx;
  color: #bbb;
}
