.page-index {
  padding-bottom: 30rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 20rpx 30rpx;
  background: #fff;
}

.search-inner {
  display: flex;
  align-items: center;
  background: #f6f7f2;
  border-radius: 40rpx;
  padding: 16rpx 28rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 16rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

/* 轮播横幅 */
.banner-swiper {
  height: 360rpx;
  margin: 20rpx 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.banner-img {
  width: 100%;
  height: 360rpx;
  border-radius: 20rpx;
}

.banner-title {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx 30rpx 24rpx;
  background: linear-gradient(transparent, rgba(0,0,0,0.55));
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 0 0 20rpx 20rpx;
}

/* 分类标签 */
.category-scroll {
  margin: 16rpx 0;
  padding: 0 30rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  padding: 8rpx 0;
}

.category-item {
  display: inline-block;
  padding: 12rpx 32rpx;
  box-sizing: border-box;
  margin-right: 16rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border: 1rpx solid #e0e0e0;
  white-space: nowrap;
  transition: all 0.3s;
}

.category-item.active {
  background: #3a7d44;
  color: #fff;
  border-color: #3a7d44;
}

/* 区域标题 */
.section-title {
  padding: 30rpx 30rpx 16rpx;
  display: flex;
  align-items: baseline;
}

.section-title-text {
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}

.section-title-sub {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

/* 故事卡片 */
.story-list {
  padding: 0 0 20rpx;
}

.story-card {
  margin: 0 30rpx 28rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(58, 125, 68, 0.07);
}

.story-cover {
  width: 100%;
  height: 340rpx;
}

.story-info {
  padding: 24rpx 28rpx;
}

.story-tags {
  margin-bottom: 12rpx;
}

.story-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.story-summary {
  display: block;
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.story-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.story-author {
  display: flex;
  align-items: center;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #e8f5e9;
}

.author-name {
  font-size: 24rpx;
  color: #666;
}

.story-stats {
  display: flex;
}

.stat-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  margin-left: 20rpx;
}

.stat-item:first-child {
  margin-left: 0;
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
}

/* 底部提示 */
.load-more-tip {
  text-align: center;
  padding: 30rpx;
}

/* AI 创作悬浮按钮 */
.ai-fab {
  position: fixed;
  right: 30rpx;
  bottom: 200rpx;
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #3a7d44, #2e7d32);
  color: #fff;
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(58,125,68,0.35);
  z-index: 50;
}

.ai-fab-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
}

.ai-fab-text {
  font-size: 24rpx;
  font-weight: 600;
}
