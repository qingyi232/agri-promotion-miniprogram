.page-recommend {
  padding-bottom: 30rpx;
  background: #f6f7f2;
}

/* 顶部标题 */
.rec-header {
  padding: 40rpx 30rpx 20rpx;
  background: #fff;
}

.rec-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #1a1a1a;
}

.rec-subtitle {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 分类标签 */
.rec-tab-scroll {
  background: #fff;
  padding: 20rpx 0 24rpx;
  white-space: nowrap;
}

.rec-tab-list {
  display: inline-flex;
  padding: 0 30rpx;
}

.rec-tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 16rpx;
  background: #f6f7f2;
  min-width: 100rpx;
  transition: all 0.3s;
  margin-right: 20rpx;
}

.rec-tab-item.active {
  background: #e8f5e9;
  border: 1rpx solid #3a7d44;
}

.rec-tab-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 6rpx;
}

.rec-tab-text {
  font-size: 24rpx;
  color: #666;
}

.rec-tab-item.active .rec-tab-text {
  color: #3a7d44;
  font-weight: 600;
}

/* 热门推荐 */
.hot-section {
  margin-top: 20rpx;
  padding: 24rpx 0;
  background: #fff;
}

.hot-header {
  padding: 0 30rpx 16rpx;
}

.hot-title-wrap {
  display: flex;
  align-items: center;
}

.hot-title-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

.hot-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.hot-scroll {
  white-space: nowrap;
}

.hot-list {
  display: inline-flex;
  padding: 0 30rpx;
}

.hot-card {
  display: inline-block;
  width: 280rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(58, 125, 68, 0.08);
}

.hot-cover {
  width: 280rpx;
  height: 200rpx;
}

.hot-info {
  padding: 16rpx;
}

.hot-card-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hot-card-stats {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #e57373;
  margin-top: 6rpx;
}

.hot-like-icon {
  width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
}

/* 瀑布流 */
.waterfall-section {
  margin-top: 20rpx;
  padding: 24rpx 30rpx 0;
}

.waterfall-header {
  margin-bottom: 20rpx;
}

.waterfall-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
}

.waterfall {
  display: flex;
}

.waterfall-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.waterfall-col:first-child {
  margin-right: 16rpx;
}

.waterfall-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(58, 125, 68, 0.06);
  margin-bottom: 16rpx;
}

.waterfall-img {
  width: 100%;
  display: block;
}

.waterfall-content {
  padding: 16rpx;
}

.waterfall-item-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.waterfall-item-meta {
  display: flex;
  align-items: center;
}

.waterfall-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  margin-right: 8rpx;
  background: #e8f5e9;
}

.waterfall-author {
  flex: 1;
  font-size: 22rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.waterfall-like {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #e57373;
}

.waterfall-like-icon {
  width: 22rpx;
  height: 22rpx;
  margin-right: 4rpx;
}
