<view class="page-profile">
  <!-- 用户信息头部 -->
  <view class="profile-header">
    <view class="profile-bg"></view>
    <view class="profile-card">
      <image class="profile-avatar" src="{{userInfo.avatarUrl || 'https://img.icons8.com/ios-filled/200/c0c0c0/user-male-circle--v1.png'}}" mode="aspectFill"></image>
      <view class="profile-info">
        <text class="profile-name">{{userInfo.nickName || '农产品爱好者'}}</text>
        <text class="profile-desc">探索大自然的馈赠</text>
      </view>
      <button class="login-btn" wx:if="{{!userInfo.nickName}}" bindtap="getUserProfile">点击登录</button>
    </view>

    <!-- 数据统计 -->
    <view class="stats-row">
      <view class="stats-item" bindtap="goFavorites">
        <text class="stats-num">{{statsData.favoriteCount || 0}}</text>
        <text class="stats-label">收藏</text>
      </view>
      <view class="stats-item" bindtap="goHistory">
        <text class="stats-num">{{statsData.historyCount || 0}}</text>
        <text class="stats-label">浏览</text>
      </view>
      <view class="stats-item" bindtap="goMyLikes">
        <text class="stats-num">{{statsData.likeCount || 0}}</text>
        <text class="stats-label">点赞</text>
      </view>
      <view class="stats-item">
        <text class="stats-num">{{statsData.commentCount || 0}}</text>
        <text class="stats-label">评论</text>
      </view>
    </view>
  </view>

  <!-- 青年策展人中心 -->
  <view class="curator-section" bindtap="goCurator">
    <view class="curator-card">
      <view class="curator-card-header">
        <image class="curator-card-icon" src="https://img.icons8.com/ios-filled/50/ffffff/paint-palette.png" mode="aspectFit"></image>
        <text class="curator-card-title">策展人中心</text>
        <image class="curator-card-arrow" src="https://img.icons8.com/ios/50/ffffff/forward--v1.png" mode="aspectFit"></image>
      </view>
      <view class="curator-card-stats">
        <view class="curator-card-stat">
          <text class="curator-card-num">{{curatorStats.pendingCount || 0}}</text>
          <text class="curator-card-label">待审核</text>
        </view>
        <text class="curator-card-sep">|</text>
        <view class="curator-card-stat">
          <text class="curator-card-num">{{curatorStats.progressCount || 0}}</text>
          <text class="curator-card-label">进行中</text>
        </view>
        <text class="curator-card-sep">|</text>
        <view class="curator-card-stat">
          <text class="curator-card-num">{{curatorStats.doneCount || 0}}</text>
          <text class="curator-card-label">已完成</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-item" bindtap="goAiStory">
        <view class="menu-left">
          <image class="menu-icon" src="https://img.icons8.com/ios-filled/50/7b1fa2/artificial-intelligence.png" mode="aspectFit"></image>
          <text class="menu-text">AI 创作故事</text>
        </view>
        <image class="menu-arrow" src="https://img.icons8.com/ios/50/cccccc/forward--v1.png" mode="aspectFit"></image>
      </view>
      <view class="menu-item" bindtap="goCurator">
        <view class="menu-left">
          <image class="menu-icon" src="https://img.icons8.com/ios-filled/50/3a7d44/paint-palette.png" mode="aspectFit"></image>
          <text class="menu-text">策展人中心</text>
        </view>
        <image class="menu-arrow" src="https://img.icons8.com/ios/50/cccccc/forward--v1.png" mode="aspectFit"></image>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="goFavorites">
        <view class="menu-left">
          <image class="menu-icon" src="https://img.icons8.com/ios-filled/50/f9a825/star--v1.png" mode="aspectFit"></image>
          <text class="menu-text">我的收藏</text>
        </view>
        <image class="menu-arrow" src="https://img.icons8.com/ios/50/cccccc/forward--v1.png" mode="aspectFit"></image>
      </view>
      <view class="menu-item" bindtap="goHistory">
        <view class="menu-left">
          <image class="menu-icon" src="https://img.icons8.com/ios-filled/50/3a7d44/clock--v1.png" mode="aspectFit"></image>
          <text class="menu-text">浏览记录</text>
        </view>
        <image class="menu-arrow" src="https://img.icons8.com/ios/50/cccccc/forward--v1.png" mode="aspectFit"></image>
      </view>
      <view class="menu-item" bindtap="goMyLikes">
        <view class="menu-left">
          <image class="menu-icon" src="https://img.icons8.com/ios-filled/50/ff6b6b/like.png" mode="aspectFit"></image>
          <text class="menu-text">我的点赞</text>
        </view>
        <image class="menu-arrow" src="https://img.icons8.com/ios/50/cccccc/forward--v1.png" mode="aspectFit"></image>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-item" bindtap="onShare">
        <view class="menu-left">
          <image class="menu-icon" src="https://img.icons8.com/ios-filled/50/3a7d44/forward-arrow.png" mode="aspectFit"></image>
          <text class="menu-text">分享给朋友</text>
        </view>
        <image class="menu-arrow" src="https://img.icons8.com/ios/50/cccccc/forward--v1.png" mode="aspectFit"></image>
      </view>
      <view class="menu-item" bindtap="onAbout">
        <view class="menu-left">
          <image class="menu-icon" src="https://img.icons8.com/ios-filled/50/3a7d44/info--v1.png" mode="aspectFit"></image>
          <text class="menu-text">关于我们</text>
        </view>
        <image class="menu-arrow" src="https://img.icons8.com/ios/50/cccccc/forward--v1.png" mode="aspectFit"></image>
      </view>
    </view>
  </view>

  <!-- 最近浏览 -->
  <view class="recent-section" wx:if="{{recentHistory.length > 0}}">
    <view class="recent-header">
      <text class="recent-title">最近浏览</text>
      <text class="recent-more" bindtap="goHistory">查看全部</text>
    </view>
    <scroll-view class="recent-scroll" scroll-x>
      <view class="recent-list">
        <view class="recent-card" wx:for="{{recentHistory}}" wx:key="_id" bindtap="goDetail" data-id="{{item.storyId}}">
          <image class="recent-cover" src="{{item.coverImage}}" mode="aspectFill"></image>
          <text class="recent-card-title">{{item.title}}</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
