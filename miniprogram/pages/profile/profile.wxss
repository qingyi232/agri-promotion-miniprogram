.page-profile {
  background: #f6f7f2;
  min-height: 100vh;
}

/* 头部区域 */
.profile-header {
  position: relative;
  background: #fff;
  padding-bottom: 30rpx;
}

.profile-bg {
  height: 240rpx;
  background: linear-gradient(135deg, #3a7d44, #5fa868, #8bc34a);
}

.profile-card {
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  margin-top: -60rpx;
  position: relative;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  background: #e8f5e9;
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
}

.profile-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
}

.profile-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.login-btn {
  background: #3a7d44 !important;
  color: #fff !important;
  font-size: 24rpx !important;
  border-radius: 30rpx !important;
  padding: 10rpx 32rpx !important;
  line-height: 1.6 !important;
  min-height: auto !important;
  border: none !important;
}

.login-btn::after {
  border: none;
}

/* 数据统计 */
.stats-row {
  display: flex;
  padding: 30rpx;
  margin-top: 10rpx;
}

.stats-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #3a7d44;
}

.stats-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 功能菜单 */
.menu-section {
  padding: 20rpx 30rpx 0;
}

.menu-group {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 28rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.menu-text {
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  width: 28rpx;
  height: 28rpx;
}

/* 最近浏览 */

/* 策展人中心卡片 */
.curator-section {
  padding: 20rpx 30rpx 0;
}

.curator-card {
  background: linear-gradient(135deg, #3a7d44, #5fa868);
  border-radius: 20rpx;
  padding: 28rpx;
  color: #fff;
}

.curator-card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.curator-card-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}

.curator-card-title {
  font-size: 30rpx;
  font-weight: 600;
  flex: 1;
}

.curator-card-arrow {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.7;
}

.curator-card-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.15);
  border-radius: 14rpx;
  padding: 20rpx 0;
}

.curator-card-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.curator-card-num {
  font-size: 38rpx;
  font-weight: 700;
}

.curator-card-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.curator-card-sep {
  opacity: 0.3;
  font-size: 28rpx;
}

/* 最近浏览 */
.recent-section {
  padding: 20rpx 0;
}

.recent-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx 16rpx;
}

.recent-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
}

.recent-more {
  font-size: 24rpx;
  color: #3a7d44;
}

.recent-scroll {
  white-space: nowrap;
}

.recent-list {
  display: inline-flex;
  padding: 0 30rpx;
}

.recent-card {
  display: inline-block;
  width: 220rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2rpx 12rpx rgba(58, 125, 68, 0.06);
  margin-right: 16rpx;
}

.recent-cover {
  width: 220rpx;
  height: 160rpx;
}

.recent-card-title {
  display: block;
  padding: 12rpx;
  font-size: 24rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
